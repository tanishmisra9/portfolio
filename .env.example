# Neon/Vercel Postgres connection string (Storage tab in the Vercel dashboard → copy the "DATABASE_URL")
DATABASE_URL=

# Vercel Blob read/write token (Storage tab → Blob store → .env.local tab)
BLOB_READ_WRITE_TOKEN=

# Session encryption key — must be at least 32 characters. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# bcrypt hash of your admin password — generate with:
#   npm run admin:hash-password -- "your password here"
# Paste the printed line as-is: Next.js expands $VAR in .env files, so the
# script escapes the hash's literal $ delimiters as \$ for you.
ADMIN_PASSWORD_HASH=
